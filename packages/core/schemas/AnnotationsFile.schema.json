{
  "$id": "https://scribui.dev/schemas/AnnotationsFile.schema.json",
  "title": "AnnotationsFile",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "round": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "screenId": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "comment",
              "circle",
              "arrow",
              "rectangle",
              "remove",
              "freehand",
              "rule",
              "sketch"
            ]
          },
          "geometry": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "point"
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "type",
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "path"
                  },
                  "points": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    }
                  }
                },
                "required": [
                  "type",
                  "points"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "rect"
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number"
                  },
                  "h": {
                    "type": "number"
                  }
                },
                "required": [
                  "type",
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "arrow"
                  },
                  "from": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "to": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "toScreenId": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "from",
                  "to"
                ],
                "additionalProperties": false
              }
            ]
          },
          "text": {
            "type": "string"
          },
          "attachedTo": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ink": {
            "type": "object",
            "properties": {
              "strokes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "points": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "items": false,
                        "minItems": 3,
                        "maxItems": 3
                      }
                    }
                  },
                  "required": [
                    "points"
                  ],
                  "additionalProperties": false
                }
              },
              "pointerType": {
                "type": "string",
                "enum": [
                  "pen",
                  "mouse",
                  "touch"
                ]
              },
              "handwriting": {
                "type": "boolean"
              }
            },
            "required": [
              "strokes",
              "pointerType",
              "handwriting"
            ],
            "additionalProperties": false
          },
          "resolution": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "resolved",
                  "region",
                  "unresolved"
                ]
              },
              "elements": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "toElements": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "region": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number"
                  },
                  "h": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "additionalProperties": false
              },
              "confirmedByUser": {
                "type": "boolean"
              }
            },
            "required": [
              "status",
              "elements",
              "confirmedByUser"
            ],
            "additionalProperties": false
          },
          "sketch": {
            "type": "object",
            "properties": {
              "shape": {
                "type": "string",
                "enum": [
                  "line",
                  "box",
                  "ellipse",
                  "text"
                ]
              },
              "style": {
                "type": "object",
                "properties": {
                  "color": {
                    "type": "string"
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "fill": {
                    "type": "string"
                  },
                  "size": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "color",
                  "width"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "shape",
              "style"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "screenId",
          "kind",
          "geometry"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "round",
    "annotations"
  ],
  "additionalProperties": false
}
