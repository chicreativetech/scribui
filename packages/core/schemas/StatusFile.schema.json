{
  "$id": "https://intentcue.dev/schemas/StatusFile.schema.json",
  "title": "StatusFile",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "round": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "capturing",
        "open",
        "sent",
        "applied"
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "sentAt": {
      "type": "string"
    },
    "appliedAt": {
      "type": "string"
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "screenId": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "reusedFrom": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "reason": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          }
        },
        "required": [
          "screenId",
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "changedScreens": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "string",
          "const": "all"
        }
      ]
    },
    "progress": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "done": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "current": {
          "type": "string"
        },
        "queue": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "total",
        "done",
        "queue"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "round",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
